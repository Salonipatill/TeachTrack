# Local development. Copy this file to .env. Never commit .env.
DEBUG=True
# Leave blank locally to generate a private .dev-secret file automatically.
# Production: use a random value of at least 50 characters from Secret Manager.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
# Blank uses a NEW local db.sqlite3. Never point this at the old uploaded database.
DATABASE_URL=
# Production Cloud SQL example (URL-encode credentials):
# DATABASE_URL=postgresql://USER:PASSWORD@/teachtrack?host=/cloudsql/PROJECT:REGION:INSTANCE
# Private Google Cloud Storage bucket. Blank locally uses media/.
GS_BUCKET_NAME=
# Only enable behind a trusted HTTPS proxy such as Google Cloud Run.
TRUST_PROXY_HEADERS=False
# Local reset emails print in the terminal. Production requires SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=teachtrack@localhost
