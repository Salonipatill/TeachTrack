# Local development. Copy this file to .env. Never commit .env.
DEBUG=True
# Leave blank locally to generate a private .dev-secret file automatically.
# Production: use a random value of at least 50 characters from Secret Manager.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
# Blank uses a NEW local db.sqlite3. Never point this at the old uploaded database.
DATABASE_URL=
# Aiven: mysql://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE
# Local PC: mysql://USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/teachtrack
# Default preserves verified Aiven TLS. Use DISABLED only for trusted local development.
MYSQL_SSL_MODE=VERIFY_IDENTITY
# Relative paths resolve from the project folder; absolute paths also work.
MYSQL_SSL_CA=certs/aiven-ca.pem
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=
MYSQL_USE_PURE=True
MYSQL_CONNECT_TIMEOUT=10
DATABASE_CONN_MAX_AGE=60
DATABASE_CONN_HEALTH_CHECKS=True
# Production Cloud SQL example (URL-encode credentials):
# DATABASE_URL=postgresql://USER:PASSWORD@/teachtrack?host=/cloudsql/PROJECT:REGION:INSTANCE
# Local uploads work with PC MySQL and do not require Google Cloud.
# Vercel: connect a PRIVATE Blob store, then select blob (or auto).
# Use auto, blob, gcs or disabled without persistent local disk.
UPLOAD_STORAGE=local
# Added when private Blob is connected to the Vercel project; keep tokens private.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN is platform-provided, not a browser/frontend variable.
# Optional private Google Cloud Storage bucket (used by auto/gcs modes only).
GS_BUCKET_NAME=
# Only enable behind a trusted HTTPS proxy such as Google Cloud Run.
TRUST_PROXY_HEADERS=False
